ENV=local
APP_NAME=ws-translation-backend
LOG_LEVEL=INFO
AWS_REGION=ap-southeast-1

# PostgreSQL 16 (Asyncpg) & Redis 7
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/translation_db
REDIS_URL=redis://localhost:6379/0

# Amazon Cognito (leave _local/local_ only when ENV=local or ENV=test)
COGNITO_USER_POOL_ID=ap-southeast-1_local
COGNITO_CLIENT_ID=local_client_id

# CORS & Auth Cookies
CORS_ORIGINS=["http://localhost:3000"]
# Set COOKIE_SECURE=true in HTTPS environments (production defaults to true)
COOKIE_SECURE=false

# S3, CloudFront CDN & AppSync Events
S3_BUCKET_NAME=ws-translation-media-local
CDN_BASE_URL=http://localhost:8000/media
APPSYNC_ENDPOINT_URL=
APPSYNC_API_KEY=

# Local / Ephemeral JWT signing secret (>=32 chars required outside local/test)
JWT_SECRET_KEY=default-insecure-dev-jwt-secret-key-32chars-min!
