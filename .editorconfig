# Top-most EditorConfig file for the ws-translation-realtime monorepo
root = true

[*]
charset = utf-8
# Enforce LF to prevent CRLF issues inside Linux Docker containers and shell scripts
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python (apps/backend, infra CDK) — matches Ruff configuration in pyproject.toml
[*.{py,pyi}]
indent_size = 4
max_line_length = 100

# Web Frontend, Config & Infrastructure (apps/web, GitHub Actions, Docker Compose)
[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss,html,yml,yaml,toml}]
indent_size = 2

# Markdown — preserve trailing spaces used for explicit line breaks
[*.md]
trim_trailing_whitespace = false

# Makefiles require hard tabs
[{Makefile,*.mk}]
indent_style = tab

# Windows batch/PowerShell scripts (if used locally on Windows)
[*.{bat,cmd,ps1}]
end_of_line = crlf
