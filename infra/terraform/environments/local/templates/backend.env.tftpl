# Auto-generated by Terraform (environments/local) - DO NOT EDIT MANUALLY
ENV=local
APP_NAME=ws-translation-backend
LOG_LEVEL=DEBUG

# AWS Region & Developer Credentials
AWS_REGION=${aws_region}
AWS_ACCESS_KEY_ID=${aws_access_key_id}
AWS_SECRET_ACCESS_KEY=${aws_secret_access_key}

# DevBox EC2: PostgreSQL 16 & Redis 7
DATABASE_URL=${database_url}
REDIS_URL=${redis_url}

# Amazon Cognito Host Authentication
COGNITO_USER_POOL_ID=${cognito_user_pool_id}
COGNITO_CLIENT_ID=${cognito_client_id}

# Amazon S3 & CloudFront CDN
S3_BUCKET_NAME=${s3_bucket_name}
CDN_BASE_URL=https://${cdn_base_url}

# AWS AppSync Events WebSocket Fan-out
APPSYNC_ENDPOINT_URL=${appsync_endpoint_url}
APPSYNC_API_KEY=${appsync_api_key}

# Ephemeral Room Token Secret
JWT_SECRET_KEY=${jwt_secret_key}
